# Local Vite dev proxy target. Restart npm run dev after changing this.
BACKEND_URL=http://localhost:3000

# Optional deployed API origin, e.g. https://api.example.com (no /api suffix).
# Leave blank for same-origin /api requests and the local Vite proxy.
# A separate API origin must allow your frontend origin through backend CORS.
VITE_API_BASE_URL=
